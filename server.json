{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.xoomar/xoomar-mcp",
  "title": "XOOMAR market data",
  "description": "Free US market data as tools: SEC filings, insiders, short interest, 13F, COT, ETF flows, liquidity.",
  "version": "0.1.8",
  "websiteUrl": "https://xoomar.com/markets/api",
  "repository": {
    "url": "https://github.com/xoomar-dev-cloud/xoomar-mcp",
    "source": "github",
    "id": "1368605895"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "xoomar-mcp",
      "version": "0.1.8",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "XOOMAR_API_KEY",
          "description": "Optional free account key from https://xoomar.com/signup: 120 requests a minute instead of 30.",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "XOOMAR_MAX_ROWS",
          "description": "Rows per tool result (default 200).",
          "isRequired": false,
          "isSecret": false,
          "format": "number",
          "default": "200"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://xoomar.com/mcp"
    }
  ]
}
